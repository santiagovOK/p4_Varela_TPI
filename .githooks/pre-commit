#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: block restricted files and validate staged Mermaid diagrams.

echo "==> [pre-commit] Ejecutando validaciones previas al commit..."

staged_files=$(git diff --cached --name-only)

if [ -n "$staged_files" ]; then
    # Keep the repository's documentation-only areas out of these checks.
    staged_files=$(printf '%s\n' "$staged_files" | grep -Ev '^(docs/sync_kanban\.js|docs/guidelines/|docs/presentation/|docs/templates/)' || true)

    restricted_env=$(printf '%s\n' "$staged_files" | grep -E '(^|/)\.env(\.[^/]+)?$' | grep -v '\.env\.example$' || true)
    if [ -n "$restricted_env" ]; then
        echo "❌ [pre-commit] ERROR: Se detectaron archivos de entorno (.env) en el commit:" >&2
        printf '%s\n' "$restricted_env" | sed 's/^/   - /' >&2
        echo "   Los archivos .env contienen credenciales locales y no deben commitearse." >&2
        exit 1
    fi

    restricted_kanban=$(printf '%s\n' "$staged_files" | grep -E '(^|/)sync_kanban\.js$' || true)
    if [ -n "$restricted_kanban" ]; then
        echo "❌ [pre-commit] ERROR: Intento de commitear archivo restringido: sync_kanban.js" >&2
        echo "   El script sync_kanban.js es de uso interno de seguimiento y no debe incluirse en commits." >&2
        exit 1
    fi
fi

tmpdir=$(mktemp -d /tmp/mermaid_precommit_XXXXXX)
trap 'rm -rf "$tmpdir"' EXIT

mmd_staged=$(printf '%s\n' "${staged_files:-}" | grep -E '\.mmd$' || true)
if [ -n "$mmd_staged" ]; then
    while IFS= read -r staged_file; do
        [ -n "$staged_file" ] || continue
        echo "🔍 [pre-commit] Validando diagrama: $staged_file..."
        git show ":$staged_file" > "$tmpdir/input.mmd"
        if ! npx -p @mermaid-js/mermaid-cli mmdc -i "$tmpdir/input.mmd" -o "$tmpdir/output.svg" 2> "$tmpdir/error.log"; then
            echo "❌ [pre-commit] ERROR al renderizar Mermaid en '$staged_file':" >&2
            cat "$tmpdir/error.log" >&2
            exit 1
        fi
        if [ ! -s "$tmpdir/output.svg" ]; then
            echo "❌ [pre-commit] ERROR: El archivo SVG generado para '$staged_file' está vacío." >&2
            exit 1
        fi
        rm -f "$tmpdir/input.mmd" "$tmpdir/output.svg" "$tmpdir/error.log"
    done <<< "$mmd_staged"
fi

md_staged=$(printf '%s\n' "${staged_files:-}" | grep -E '\.md$' || true)
if [ -n "$md_staged" ]; then
    while IFS= read -r staged_md; do
        [ -n "$staged_md" ] || continue
        md_block_dir="$tmpdir/md_blocks"
        mkdir -p "$md_block_dir"
        rm -f "$md_block_dir"/*
        git show ":$staged_md" > "$tmpdir/staged.md"

        count=$(awk -v outdir="$md_block_dir" '
        BEGIN { in_block=0; count=0 }
        /^```mermaid/ { count++; file=sprintf("%s/diagram-%d.mmd", outdir, count); in_block=1; next }
        /^```/ { if (in_block) { in_block=0; next } }
        { if (in_block) print > file }
        END { print count }
        ' "$tmpdir/staged.md")

        if [ "$count" -gt 0 ]; then
            echo "🔍 [pre-commit] Validando $count bloque(s) Mermaid en: $staged_md..."
            for i in $(seq 1 "$count"); do
                diag_file="$md_block_dir/diagram-$i.mmd"
                svg_file="$md_block_dir/diagram-$i.svg"
                if ! npx -p @mermaid-js/mermaid-cli mmdc -i "$diag_file" -o "$svg_file" 2> "$tmpdir/error.log"; then
                    echo "❌ [pre-commit] ERROR al renderizar bloque Mermaid #$i en '$staged_md':" >&2
                    cat "$tmpdir/error.log" >&2
                    exit 1
                fi
                if [ ! -s "$svg_file" ]; then
                    echo "❌ [pre-commit] ERROR: El SVG generado para bloque Mermaid #$i en '$staged_md' está vacío." >&2
                    exit 1
                fi
            done
        fi
        rm -rf "$md_block_dir" "$tmpdir/staged.md"
    done <<< "$md_staged"
fi

echo "✅ [pre-commit] Todas las validaciones completadas con éxito."
exit 0
